node_modules
dist
dist-ssr
*.local
.DS_Store
.vscode/*
!.vscode/extensions.json
dev-dist

# Supabase CLI local state (per-machine, not for version control)
supabase/.temp/
supabase/.branches/

# Data exports from Settings → Your Data. These hold real warband and campaign
# rows, and anything under public/ is copied verbatim into the deployed site —
# a backup saved there would be downloadable by anyone who guessed the URL.
mordheim-backup-*.json

# Design sources. Anything under public/ is copied verbatim into the deployed
# site, so working files belong in design/ — see design/ for the icon and
# banner originals.
public/**/*.ai
public/**/*.psd
