# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# PostHog project settings (public client-side values)
VITE_POSTHOG_KEY=your-posthog-project-token
VITE_POSTHOG_HOST=https://your-posthog-host

# Web Push (§19.4) — the PUBLIC half of the VAPID key pair. Generate with
# `npx web-push generate-vapid-keys`; the private key is a Supabase Edge
# Function secret, never here. Push is simply unavailable if this is unset.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
