# Cache-Control, in the two places it actually matters.
#
# Read from the assets directory by Cloudflare Workers Static Assets, and from
# the publish directory by Netlify. Vite copies public/ into dist/ verbatim, so
# one file serves both.
#
# SPA routing is *not* here: it lives in wrangler.toml's `not_found_handling` for
# Workers and in netlify.toml for Netlify. A `/* /index.html 200` line in a
# companion _redirects file would do the same job, but redirects are evaluated
# before headers and win on a match — and a `/*` rule matches /assets/* too,
# dropping the very header below that those files exist to get.

# The service worker must never be served stale. It is the thing that decides
# how everything else is cached, so a cached worker pins a cached app — which is
# the shape of the bug that made two correct deploys look broken (see the
# workbox notes in vite.config.ts).
/sw.js
  Cache-Control: no-cache

# Hashed filenames can never change contents, so they are safe to keep forever.
# This is also what the service worker's CacheFirst rule for /assets/ already
# assumes; without it the CDN re-validates on every load for no reason.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted font subsets (scripts/fetch-fonts.mjs). The filenames aren't
# content-hashed, but a given weight/subset's bytes don't change — re-running
# the script to add a weight writes new names. Long-lived like /assets/, and the
# SW keeps them offline. fonts.css itself (no rule here) stays revalidated so a
# new weight is picked up.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
