# Cache-Control, in the two places it actually matters.
#
# Read by Cloudflare Pages and Netlify both.

# The service worker must never be served stale. It is the thing that decides
# how everything else is cached, so a cached worker pins a cached app — which is
# the shape of the bug that made two correct deploys look broken (see the
# workbox notes in vite.config.ts).
/sw.js
  Cache-Control: no-cache

# Hashed filenames can never change contents, so they are safe to keep forever.
# This is also what the service worker's CacheFirst rule for /assets/ already
# assumes; without it the CDN re-validates on every load for no reason.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
